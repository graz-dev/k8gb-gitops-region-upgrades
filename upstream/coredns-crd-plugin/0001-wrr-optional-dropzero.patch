+
+import (
+	"context"
+	"net"
+	"testing"
+
+	"github.com/coredns/coredns/plugin/test"
+	"github.com/miekg/dns"
+	"github.com/stretchr/testify/assert"
+
+	"github.com/k8gb-io/coredns-crd-plugin/common/k8sctrl"
+	"github.com/k8gb-io/coredns-crd-plugin/common/netutils"
+)
+
+// capture is the smallest dns.ResponseWriter that keeps the message the plugin wrote.
+type capture struct {
+	dns.ResponseWriter
+	msg *dns.Msg
+}
+
+func (c *capture) WriteMsg(m *dns.Msg) error { c.msg = m; return nil }
+func (c *capture) RemoteAddr() net.Addr      { return &net.UDPAddr{IP: net.ParseIP("127.0.0.1")} }
+func (c *capture) LocalAddr() net.Addr       { return &net.UDPAddr{IP: net.ParseIP("127.0.0.1")} }
+
+func answerIPs(c *capture) map[string]bool {
+	ips := map[string]bool{}
+	if c.msg == nil {
+		return ips
+	}
+	_, ip, _ := netutils.ParseAnswerSection(c.msg.Answer)
+	for _, v := range ip {
+		ips[v] = true
+	}
+	return ips
+}
+
+func serve(t *testing.T, w *WeightRoundRobin, labels map[string]string) *capture {
+	t.Helper()
+	const host = "podinfo.cloud.example.com"
+	all := []dns.RR{
+		test.A(host + ". 5 IN A 10.0.0.1"),
+		test.A(host + ". 5 IN A 10.0.0.2"),
+		test.A(host + ". 5 IN A 10.0.1.1"),
+		test.A(host + ". 5 IN A 10.0.1.2"),
+	}
+	k8sctrl.Resources.DNSEndpoint.Lookup = func(string, net.IP, string, [][]string) k8sctrl.LocalDNSEndpoint {
+		return k8sctrl.LocalDNSEndpoint{DNSName: host, Labels: labels,
+			Targets: []string{"10.0.0.1", "10.0.0.2", "10.0.1.1", "10.0.1.2"}}
+	}
+	msg := new(dns.Msg)
+	msg.SetQuestion(host+".", dns.TypeA)
+	msg.Answer = all
+	c := &capture{}
+	_, err := w.ServeDNS(context.TODO(), c, msg)
+	assert.NoError(t, err)
+	return c
+}
+
+// eu has weight 0, us has weight 1.
+var euZeroUsOne = map[string]string{
+	"strategy":      "roundRobin",
+	"weight-eu-0-0": "10.0.0.1",
+	"weight-eu-1-0": "10.0.0.2",
+	"weight-us-0-1": "10.0.1.1",
+	"weight-us-1-1": "10.0.1.2",
+}
+
+func TestZeroWeightsAreReturnedLastByDefault(t *testing.T) {
+	c := serve(t, NewWeightRoundRobin(), euZeroUsOne)
+	assert.Len(t, c.msg.Answer, 4, "default behaviour: weight 0 only reorders")
+	// the first two answers must be the weighted region
+	first := c.msg.Answer[0].(*dns.A).A.String()
+	second := c.msg.Answer[1].(*dns.A).A.String()
+	assert.Contains(t, []string{"10.0.1.1", "10.0.1.2"}, first)
+	assert.Contains(t, []string{"10.0.1.1", "10.0.1.2"}, second)
+}
+
+func TestDropZeroWeightsLeavesTheRegionOut(t *testing.T) {
+	for i := 0; i < 50; i++ { // the order is random, the content must not be
+		c := serve(t, NewWeightRoundRobin(DropZeroWeights()), euZeroUsOne)
+		assert.Equal(t, map[string]bool{"10.0.1.1": true, "10.0.1.2": true}, answerIPs(c))
+	}
+}
+
+func TestDropZeroWeightsNeverAnswersEmpty(t *testing.T) {
+	allZero := map[string]string{
+		"strategy":      "roundRobin",
+		"weight-eu-0-0": "10.0.0.1",
+		"weight-eu-1-0": "10.0.0.2",
+		"weight-us-0-0": "10.0.1.1",
+		"weight-us-1-0": "10.0.1.2",
+	}
+	c := serve(t, NewWeightRoundRobin(DropZeroWeights()), allZero)
+	assert.Len(t, c.msg.Answer, 4, "when every weight is 0 nothing is dropped")
+}
+
+func TestDropZeroWeightsKeepsPositiveRegionsOnly(t *testing.T) {
+	threeUp := map[string]string{
+		"strategy":      "roundRobin",
+		"weight-eu-0-0": "10.0.0.1",
+		"weight-eu-1-0": "10.0.0.2",
+		"weight-us-0-5": "10.0.1.1",
+		"weight-us-1-5": "10.0.1.2",
+	}
+	c := serve(t, NewWeightRoundRobin(DropZeroWeights()), threeUp)
+	assert.Equal(t, map[string]bool{"10.0.1.1": true, "10.0.1.2": true}, answerIPs(c))
+}
